/dts-v1/;

/ {
	description = "ADSP-SC846 kernel FIT image";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux kernel";
			data = /incbin/("./Image");
			type = "kernel";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x9a200000>;
			entry = <0x9a200000>;
			hash-1 {
				algo = "crc32";
			};
		};
		fdt-sc846-som-ezkit.dtb {
			description = "sc846-som-ezkit.dtb";
			data = /incbin/("./sc846-som-ezkit.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "conf-@DEFAULT_DTB@";
		conf-sc846-som-ezkit.dtb {
			description = "Linux kernel, sc846-som-ezkit.dtb";
			kernel = "kernel";
			fdt = "fdt-sc846-som-ezkit.dtb";
		};
	};
};
